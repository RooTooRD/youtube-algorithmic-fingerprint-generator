# Copy to .env — never commit the result.

ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

YAFG_DB_URL=sqlite+aiosqlite:///data/yafg.db
YAFG_DATA_DIR=data
YAFG_PROFILE_DIR=data/profiles

YAFG_HEADLESS=true
YAFG_LOG_LEVEL=INFO

# Optional dry-run pricing inputs. Leave blank to report token estimates without USD.
YAFG_LLM_INPUT_USD_PER_MILLION=
YAFG_LLM_OUTPUT_USD_PER_MILLION=

# Public-caption retrieval is opt-in and paced separately from official API metadata.
YAFG_TRANSCRIPT_MAX_REQUESTS_PER_HOUR=120

# Global kill-switch for platform side effects (likes/subscribes). Experiment YAML
# must ALSO enable them. Leave false for observation-only runs.
YAFG_ALLOW_INTERACTIONS=false
